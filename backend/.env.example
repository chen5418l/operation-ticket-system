DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=power_ticket_system
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 数据源模式: realtime / mock / static
DATA_SOURCE_MODE=realtime
# Simulink/MATLAB 联调密钥 — 请和张同学约定一个复杂密钥
SIMULINK_SOURCE_TOKEN=your_simulink_token_here

# ==================== 张同学外部算法服务适配器 ====================
# 留空表示不启用该项桥接；填写完整 URL 后端点会自动尝试调用并降级
ALGO_FORECAST_URL=
ALGO_FAULT_ANALYZE_URL=
ALGO_BOUNDARY_ANALYZE_URL=
ALGO_TRANSFER_RECOMMEND_URL=
ALGO_SAFETY_VALIDATE_URL=
# 外部算法调用超时（秒），默认 5
ALGO_TIMEOUT_SECONDS=5

# ==================== IEEE33 算法服务正式接口适配器 ====================
# 基于《IEEE33 算法服务正式接口清单》，单入口 + 算法密钥认证
# X-Algorithm-Key 仅用于调用算法业务接口，与 Simulink 推送的 X-Simulink-Token 完全隔离
# 优先使用 ALGO_SERVICE_BASE_URL / ALGO_SERVICE_KEY（张同学文档约定键名）
# 也兼容旧键名 ALGO_BASE_URL / ALGORITHM_KEY 作为回退
ALGO_SERVICE_BASE_URL=http://100.73.79.86:8010
ALGO_SERVICE_KEY=
ALGO_TIMEOUT_MS=5000
ALGO_JOB_POLL_INTERVAL_MS=1000
ALGO_JOB_MAX_WAIT_MS=180000
ALGO_JOB_TIMEOUT_MS=20000
