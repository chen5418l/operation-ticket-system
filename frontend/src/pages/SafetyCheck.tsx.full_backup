import { useState } from 'react';
import PageContainer from '../layouts/PageContainer';
import SectionCard from '../components/SectionCard';
import DataTable from '../components/DataTable';
import StatusBadge from '../components/StatusBadge';
import MetricCard from '../components/MetricCard';

function fmt(v: unknown, d = 2): string { const n = Number(v); return Number.isFinite(n) ? n.toFixed(d) : '--'; }

const FAULT_TYPES = ['三相短路', '单相接地', '两相短路'];

export default function SafetyCheck() {
  // 场景配置
  const [faultNode, setFaultNode] = useState(18);
  const [faultType, setFaultType] = useState('三相短路');
  const [faultDuration, setFaultDuration] = useState(0.1);
  const [switches, setSwitches] = useState<Record<string, number>>(
    Object.fromEntries(Array.from({ length: 37 }, (_, i) => [`Switch${i + 1}`, 1]))
  );

  // 结果
  const [result, setResult] = useState<any>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  // ====== 加载默认场景 ======
  const loadDefault = async () => {
    try {
      const r = await fetch('http://localhost:8000/api/safety/default_scenario');
      const d = await r.json();
      if (d.success && d.scenario) {
        setFaultNode(d.scenario.FaultNode);
        setFaultType(d.scenario.FaultType);
        setFaultDuration(d.scenario.FaultDuration);
        if (d.scenario.Switches) setSwitches(d.scenario.Switches);
      }
    } catch { alert('加载默认场景失败，请确认后端已启动'); }
  };

  // ====== 恢复默认开关 ======
  const resetSwitches = () => {
    setSwitches(Object.fromEntries(Array.from({ length: 37 }, (_, i) => [`Switch${i + 1}`, 1])));
  };

  const toggleSwitch = (key: string) => {
    setSwitches(prev => ({ ...prev, [key]: prev[key] === 1 ? 0 : 1 }));
  };

  // ====== 执行校验 ======
  const runCheck = async () => {
    setLoading(true); setError(''); setResult(null);
    try {
      const body = JSON.stringify({ FaultNode: faultNode, FaultType: faultType, FaultDuration: faultDuration, Switches: switches });
      const r = await fetch('http://localhost:8000/api/safety/isolation_check', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body });
      const d = await r.json();
      if (!d.success) { setError(d.error || '校验失败'); return; }
      setResult(d);
    } catch (e: any) { setError('请求失败: ' + (e.message || '')); }
    finally { setLoading(false); }
  };

  // ====== 下载报告 ======
  const downloadReport = () => {
    window.open('http://localhost:8000/api/safety/download_report', '_blank');
  };

  // ====== 检查明细表格 ======
  const checks = Array.isArray((Array.isArray(result?.checks) ? result.checks : [])) ? result.checks : [];
  const checkCols = [
    { key: 'item', title: '检查项', dataIndex: 'item' as const },
    { key: 'result', title: '结论', dataIndex: 'result' as const, width: 80,
      render: (r: any) => <StatusBadge status={r.result} /> },
    { key: 'detail', title: '详细说明', dataIndex: 'detail' as const },
    { key: 'risk_level', title: '风险等级', dataIndex: 'risk_level' as const, width: 80,
      render: (r: any) => <StatusBadge status={r.risk_level === '低' ? '低' : r.risk_level === '中' ? '中' : '高'} /> },
  ];

  const m = result?.metrics || {};

  return (
    <PageContainer title="安全校验">
      {/* 说明 */}
      <div style={{ background: '#e3f0ff', border: '1px solid #90caf9', borderRadius: 6, padding: '10px 16px', marginBottom: 16, fontSize: 12, color: '#1f2937' }}>
        安全校验模块用于对故障隔离与转供方案进行约束校验。配置故障节点和开关状态后，系统调用安全校验模型，评估方案是否满足隔离完整性、网架结构、容量、电压、重要用户恢复率等约束。
      </div>

      <div style={{ display: 'flex', gap: 16, flexWrap: 'wrap' }}>
        {/* 左侧：配置区 */}
        <div style={{ flex: '0 0 380px' }}>
          <SectionCard title="故障场景配置">
            <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <span style={lbl}>故障节点</span>
                <select value={faultNode} onChange={e => setFaultNode(Number(e.target.value))} style={inp}>
                  {Array.from({ length: 33 }, (_, i) => i + 1).map(n => <option key={n} value={n}>Bus {n}</option>)}
                </select>
              </div>
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <span style={lbl}>故障类型</span>
                <select value={faultType} onChange={e => setFaultType(e.target.value)} style={inp}>
                  {FAULT_TYPES.map(t => <option key={t} value={t}>{t}</option>)}
                </select>
              </div>
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <span style={lbl}>持续时间(s)</span>
                <input type="number" value={faultDuration} onChange={e => setFaultDuration(Number(e.target.value))}
                  min={0.01} max={10} step={0.01} style={{ ...inp, width: 80 }} />
              </div>
            </div>
          </SectionCard>

          <SectionCard title={`开关状态 (${Object.values(switches).filter(v => v === 1).length} 闭合 / ${Object.values(switches).filter(v => v === 0).length} 断开)`} style={{ marginTop: 12 }}>
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(6,1fr)', gap: 4, maxHeight: 300, overflowY: 'auto' }}>
              {Object.entries(switches).map(([key, val]) => (
                <div key={key}
                  onClick={() => toggleSwitch(key)}
                  style={{
                    padding: '4px 6px', borderRadius: 4, cursor: 'pointer', textAlign: 'center', fontSize: 10,
                    background: val === 1 ? '#e8f5e9' : '#ffebee',
                    color: val === 1 ? '#1f8a4c' : '#e74c3c',
                    border: `1px solid ${val === 1 ? '#a5d6a7' : '#ffcdd2'}`,
                    fontWeight: 600, userSelect: 'none',
                  }}>
                  {key.replace('Switch', 'S')}: {val === 1 ? '合' : '开'}
                </div>
              ))}
            </div>
          </SectionCard>

          <div style={{ display: 'flex', gap: 8, marginTop: 12 }}>
            <button onClick={loadDefault} style={btn2}>加载默认场景</button>
            <button onClick={resetSwitches} style={btn2}>恢复默认开关</button>
            <button onClick={runCheck} disabled={loading} style={btn1}>
              {loading ? '校验中...' : '运行安全校验'}
            </button>
          </div>
        </div>

        {/* 右侧：结果区 */}
        <div style={{ flex: 1, minWidth: 400 }}>
          {result && (
            <>
              {/* 结论卡片 */}
              <div style={{
                display: 'flex', gap: 10, marginBottom: 14, padding: '12px 16px', borderRadius: 6,
                background: result.check_passed === false ? '#ffebee' : result.risk_level === '中风险' ? '#fff8e1' : '#e8f5e9',
                border: `2px solid ${result.check_passed === false ? '#e74c3c' : result.risk_level === '中风险' ? '#f2c94c' : '#1f8a4c'}`,
              }}>
                <span style={{ fontSize: 18, fontWeight: 700, color: result.check_passed === false ? '#e74c3c' : result.risk_level === '中风险' ? '#f2c94c' : '#1f8a4c' }}>
                  {result.check_passed === false ? '🚫' : result.risk_level === '中风险' ? '⚠️' : '✅'} {result.overall_result || '--'}
                </span>
                <span style={{ fontSize: 13, color: '#667085' }}>风险等级: <StatusBadge status={result.risk_level || '--'} /></span>
                {result.note && <span style={{ fontSize: 11, color: '#f2c94c' }}>⚠ {result.note}</span>}
              </div>

              {/* 指标卡 */}
              <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap', marginBottom: 14 }}>
                <MetricCard label="失供负荷" value={fmt(m.lost_load_kw)} unit="kW" color="#eb5757" />
                <MetricCard label="重要用户恢复率" value={fmt(m.important_restore_rate)} unit="%" color="#2f80ed" />
                <MetricCard label="加权恢复率" value={fmt(m.weighted_restore_rate)} unit="%" color="#1f8a4c" />
                <MetricCard label="开关动作次数" value={fmt(m.switch_action_count, 0)} unit="次" color="#f2c94c" />
                <MetricCard label="远方操作比例" value={fmt(m.remote_operation_rate)} unit="%" color="#2f80ed" />
                <MetricCard label="数据可信度" value={fmt(m.data_confidence)} unit="%" color="#1f8a4c" />
              </div>

              {/* 摘要 */}
              {result.summary && (
                <div style={{ marginBottom: 14, padding: '8px 12px', background: '#f3f6f9', borderRadius: 4, fontSize: 12, color: '#1f2937' }}>
                  {result.summary}
                </div>
              )}

              {/* 检查明细表 */}
              <SectionCard title="检查明细">
                {checks.length > 0 ? (
                  <DataTable columns={checkCols} data={checks} rowKey={(_r: any, i: number) => String(i)} />
                ) : (
                  <div style={{ textAlign: 'center', padding: 30, color: '#94a3b8', fontSize: 12 }}>暂无检查明细</div>
                )}
              </SectionCard>

              <button onClick={downloadReport} style={{ marginTop: 10, ...btn2 }}>
                下载报告 (report.xlsx)
              </button>
            </>
          )}

          {!result && !loading && !error && (
            <div style={{ textAlign: 'center', padding: 60, color: '#94a3b8', fontSize: 13, background: '#fff', borderRadius: 6, border: '1px solid #c8d6e5' }}>
              配置故障场景和开关状态后，点击"运行安全校验"
            </div>
          )}

          {error && (
            <div style={{ padding: '12px 16px', background: '#ffebee', borderRadius: 6, border: '1px solid #ffcdd2', color: '#e74c3c', fontSize: 12 }}>
              ❌ {error}
            </div>
          )}
        </div>
      </div>
    </PageContainer>
  );
}

const lbl: React.CSSProperties = { fontSize: 12, color: '#667085', width: 90, flexShrink: 0 };
const inp: React.CSSProperties = { padding: '5px 10px', borderRadius: 4, border: '1px solid #c8d6e5', fontSize: 12, background: '#fff' };
const btn1: React.CSSProperties = { padding: '6px 16px', borderRadius: 4, fontSize: 12, cursor: 'pointer', background: '#1f8a4c', color: '#fff', border: 'none' };
const btn2: React.CSSProperties = { padding: '6px 12px', borderRadius: 4, fontSize: 11, cursor: 'pointer', background: '#fff', color: '#667085', border: '1px solid #c8d6e5' };
